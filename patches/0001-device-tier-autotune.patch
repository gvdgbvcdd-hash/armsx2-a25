+package com.armsx2.config
+
+import java.io.File
+
+/**
+ * How many fast ("performance") cores this device has, read the way the native core reads them.
+ *
+ * The core confines the EE, GS and (with MTVU) VU1 threads to the performance tier only when the tier
+ * has a processor for each of them (IopThread::PlanTier in pcsx2/IopThread/IopPlacement.cpp); otherwise it
+ * leaves them to the scheduler. A part with two fast cores (Exynos 1280: 2x Cortex-A78 + 6x Cortex-A55)
+ * never gets that placement, and it is the class of device whose games miss frames most. That is the
+ * device automatic performance tuning is for, so [autoTuneDefault] turns it on there and nowhere else.
+ *
+ * Same source and same ratio as IopThread::PerformanceMask: /sys/devices/system/cpu/cpuN/cpu_capacity,
+ * and every core within [PERFORMANCE_CLUSTER_RATIO] of the fastest. Frequency is deliberately NOT a
+ * fallback: an A78 at 2.4 GHz against an A55 at 2.0 GHz is a ratio of 0.83, which would put the little
+ * cores in the tier. When capacity cannot be read the answer is "unknown", and unknown changes nothing.
+ */
+object DeviceTier {
+    /** Mirrors IopThread::kPerformanceClusterRatio. */
+    const val PERFORMANCE_CLUSTER_RATIO = 0.75
+
+    /** EE + GS + VU1 (MTVU). Fewer performance cores than this cannot hold the core's busy threads. */
+    const val BUSY_THREADS = 3
+
+    private val CPU_DIR_NAME = Regex("cpu[0-9]+")
+
+    /** cpu_capacity of every processor in cpu-number order; 0 where unreadable. Empty with nothing to read. */
+    internal fun readCapacities(cpuDir: File = File("/sys/devices/system/cpu")): List<Int> {
+        val dirs = cpuDir.listFiles()?.filter { it.isDirectory && CPU_DIR_NAME.matches(it.name) }
+            ?: return emptyList()
+        return dirs
+            .sortedBy { it.name.substring(3).toInt() }
+            .map { readInt(File(it, "cpu_capacity")) }
+    }
+
+    /** Plain stream read: sysfs nodes report a size of 0, so a size-based read comes back empty. */
+    private fun readInt(file: File): Int = try {
+        file.bufferedReader().use { it.readLine() }?.trim()?.toIntOrNull()?.coerceAtLeast(0) ?: 0
+    } catch (e: Exception) {
+        0
+    }
+
+    /** Processors within [PERFORMANCE_CLUSTER_RATIO] of the fastest, or null when the cores cannot be told apart. */
+    internal fun performanceCores(capacities: List<Int>): Int? {
+        val peak = capacities.maxOrNull() ?: return null
+        if (peak <= 0) return null
+        val threshold = (peak * PERFORMANCE_CLUSTER_RATIO).toInt()
+        return capacities.count { it > 0 && it >= threshold }
+    }
+
+    /** True only when the tier is known and too narrow for the core's busy threads. */
+    internal fun isNarrow(performanceCores: Int?): Boolean =
+        performanceCores != null && performanceCores < BUSY_THREADS
+
+    // ART reports "Dalvik" as its VM name. Off a device (JVM unit tests, desktop tools) nothing is probed,
+    // so a host that happens to expose cpu_capacity cannot change a default under test.
+    private val onAndroid: Boolean = System.getProperty("java.vm.name") == "Dalvik"
+
+    /** Performance-core count of this device; null off-device or when capacity cannot be read. */
+    val performanceCoreCount: Int? by lazy {
+        if (onAndroid) performanceCores(readCapacities()) else null
+    }
+
+    /** Default for EmuCore/AutoTune: on for a narrow performance tier, off otherwise and when unknown. */
+    val autoTuneDefault: Boolean
+        get() = isNarrow(performanceCoreCount)
+}
