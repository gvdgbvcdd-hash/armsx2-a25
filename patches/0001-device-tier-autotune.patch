index 0000000..d4d6e33
--- /dev/null
+++ b/platforms/android/app/src/test/java/com/armsx2/config/DeviceTierTest.kt
@@ -0,0 +1,100 @@
+package com.armsx2.config
+
+import java.io.File
+import java.nio.file.Files
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * The tier probe must agree with the native IopThread::PerformanceMask, because the default it drives is
+ * "the core's thread placement cannot fit this device". The capacity values below are synthetic: only the
+ * ratio between them matters, and the real numbers differ by device.
+ */
+class DeviceTierTest {
+    private fun cores(vararg groups: Pair<Int, Int>): List<Int> =
+        groups.flatMap { (count, capacity) -> List(count) { capacity } }
+
+    @Test
+    fun twoFastCoresAndSixLittleOnesIsNarrow() {
+        val tier = DeviceTier.performanceCores(cores(6 to 250, 2 to 1024))
+        assertEquals(2, tier)
+        assertTrue(DeviceTier.isNarrow(tier))
+    }
+
+    @Test
+    fun threeFastCoresHoldEeGsAndVu1() {
+        val tier = DeviceTier.performanceCores(cores(4 to 250, 3 to 1024, 1 to 1024))
+        assertEquals(4, tier)
+        assertFalse(DeviceTier.isNarrow(tier))
+        assertFalse(DeviceTier.isNarrow(DeviceTier.performanceCores(cores(5 to 250, 3 to 1024))))
+    }
+
+    @Test
+    fun primePlusGoldCoresAreOneTier() {
+        // One core at the top and three within 0.75 of it, then four little ones.
+        val tier = DeviceTier.performanceCores(cores(4 to 250, 3 to 871, 1 to 1024))
+        assertEquals(4, tier)
+        assertFalse(DeviceTier.isNarrow(tier))
+    }
+
+    @Test
+    fun aCoreJustBelowTheRatioIsNotInTheTier() {
+        // threshold = (1000 * 0.75).toInt() = 750: 750 is in, 749 is out.
+        assertEquals(3, DeviceTier.performanceCores(listOf(1000, 750, 750, 749)))
+    }
+
+    @Test
+    fun identicalCoresAreAllPerformanceCores() {
+        assertEquals(8, DeviceTier.performanceCores(cores(8 to 1024)))
+        assertFalse(DeviceTier.isNarrow(8))
+    }
+
+    @Test
+    fun unreadableCapacityIsUnknownAndChangesNothing() {
+        assertNull(DeviceTier.performanceCores(emptyList()))
+        assertNull(DeviceTier.performanceCores(cores(8 to 0)))
+        assertFalse(DeviceTier.isNarrow(null))
+    }
+
+    @Test
+    fun anUnreadableCoreIsNeverCounted() {
+        assertEquals(2, DeviceTier.performanceCores(listOf(1024, 1024, 0, 0)))
+    }
+
+    @Test
+    fun offDeviceTheDefaultIsUnchanged() {
+        // The JVM running these tests is not ART, so nothing is probed.
+        assertNull(DeviceTier.performanceCoreCount)
+        assertFalse(DeviceTier.autoTuneDefault)
+        assertFalse(Settings().emuCore.autoTune)
+    }
+
+    @Test
+    fun readsCapacitiesFromSysfsLayout() {
+        val root = Files.createTempDirectory("cpu").toFile()
+        try {
+            // Created out of order, with the directories sysfs also has under /sys/devices/system/cpu.
+            val capacities = mapOf(10 to "1024\n", 2 to "250\n", 0 to "250\n", 1 to "250")
+            for ((id, text) in capacities) {
+                File(root, "cpu$id").mkdirs()
+                File(root, "cpu$id/cpu_capacity").writeText(text)
+            }
+            File(root, "cpu3").mkdirs() // no cpu_capacity node: reads as 0
+            File(root, "cpufreq").mkdirs()
+            File(root, "cpuidle").mkdirs()
+            File(root, "possible").writeText("0-10")
+
+            assertEquals(listOf(250, 250, 250, 0, 1024), DeviceTier.readCapacities(root))
+        } finally {
+            root.deleteRecursively()
+        }
+    }
+
+    @Test
+    fun aMissingDirectoryReadsAsEmpty() {
+        assertEquals(emptyList<Int>(), DeviceTier.readCapacities(File("/definitely/not/here")))
+    }
+}
